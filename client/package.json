{
  "name": "zephyrex-rpg-wiki-client",
  "version": "1.0.0-alpha.1",
  "private": true,
  "description": "Zephyrex RPG Wiki client, built on the Zephyrex framework",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "next dev -p 1109",
    "build": "next build",
    "start": "next start -p 1109",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006",
    "storybook-build": "storybook build",
    "storybook-test": "test-storybook --url http://localhost:6006",
    "refresh:zephyrex": "pnpm update --no-save zephyrex @zephyrex/auth @zephyrex/lite @zephyrex/marketing @jgrieve/forms zod2gql"
  },
  "dependencies": {
    "@jgrieve/forms": "^0.0.1-alpha.1",
    "@zephyrex/auth": "^0.0.1-alpha.1",
    "@zephyrex/lite": "^0.0.1-alpha.1",
    "@zephyrex/marketing": "^0.0.1-alpha.1",
    "next": "^16.2.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zephyrex": "^0.0.1-alpha.1",
    "zod": "^4.4.3",
    "zod2gql": "^0.1.0-alpha.1"
  },
  "dependenciesMeta": {
    "zephyrex": {
      "injected": true
    },
    "@zephyrex/auth": {
      "injected": true
    },
    "@jgrieve/forms": {
      "injected": true
    },
    "zod2gql": {
      "injected": true
    },
    "@zephyrex/lite": {
      "injected": true
    },
    "@zephyrex/marketing": {
      "injected": true
    }
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-links": "^10.6.1",
    "@storybook/nextjs": "^10.6.1",
    "@storybook/react": "^10.6.1",
    "@storybook/test-runner": "^0.24.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^25.8.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.28",
    "storybook": "^10.6.1",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^6.0.3",
