// @zephyrex-rpg/wiki's lite records: the same resources, fields and rules as the SaaS server's
// extensions (server/extensions/rpg_core, world_*; genealogy's Person). Every record belongs to the
// one local owner (@zephyrex/lite localOwner). Entries are Plate values as JSON text.
//
// A fragment of a Prisma multi-file schema: an app that serves the wiki's lite routes copies it into
// its prisma/schema folder (scripts/prisma-fragment.mjs) beside its own datasource and generator,
// and generates its own migrations from the result. Models only; never edit the copy.

/// A world: the top-level container every record scopes to (rpg_core's CampaignModel).
/// A setting (S6): the universe campaigns take place in. Its canon is every world record with this
/// setting and no campaign. VTT's game systems name settings by slug.
model Setting {
  id          String   @id @default(uuid())
  createdById String
  name        String
  description String   @default("")
  entry       String?
  /// Its stable name (contract/wiki.json setting_slug): unique, fixed once set (S6b).
  slug        String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  updatedById String?

  @@index([createdById])
}

model Campaign {
  id           String   @id @default(uuid())
  createdById  String
  name         String
  description  String   @default("")
  /// The setting it takes place in (S6); fixed once set.
  settingId    String?
  /// Where it came from: homebrew, official or adapted (contract provenances).
  provenance   String   @default("homebrew")
  /// The official title, publisher and product or page; none for homebrew.
  source       String?
  /// A scenario: play never edits it; starting it copies it (copy on start).
  isScenario   Boolean?
  /// The scenario this campaign is a playthrough of.
  scenarioId   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime
  updatedById  String?

  @@index([createdById])
}

/// A place at any scale, under its parent (world_spatial's LocationModel, with rpg_core's campaign).
model Location {
  id           String   @id @default(uuid())
  createdById  String
  name         String
  description  String   @default("")
  entry        String?
  kind         String?
  parentId     String?
  campaignId   String?
  /// With no campaign: the setting's canon (S6).
  settingId   String?
  canonLevel  String?
  isTemplate  Boolean?
  /// S4c: other names it goes by, and what else wakes it in the AI's lorebook (JSON text).
  aliases     String?
  keywords    String?
  /// S4d: its lorebook activation (SillyTavern World Info's fields, JSON text).
  lore        String?
  /// Where it came from: homebrew, official or adapted, and its source.
  provenance  String   @default("homebrew")
  source      String?
  /// Its picture by https link (fandom, wikis…), shown before an uploaded one.
  pictureUrl  String?
  /// The person it belongs to: their equipment slots and body parts (what they wear sits there).
  associatedPersonId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime
  updatedById  String?
  /// Soft delete: a tombstone a since-sync reads (rpg-ai A15); hidden from normal reads.
  deletedAt    DateTime?

  @@index([createdById])
  @@index([deletedAt])
  @@index([campaignId])
  @@index([parentId])
  @@index([associatedPersonId])
  @@index([settingId])
}

/// A person or creature (genealogy's PersonModel, with rpg_core's character fields).
model Person {
  id           String    @id @default(uuid())
  createdById  String
  name         String
  description  String    @default("")
  entry        String?
  kind         String?
  campaignId   String?
  /// With no campaign: the setting's canon (S6).
  settingId   String?
  canonLevel  String?
  isTemplate  Boolean?
  /// S4c: other names it goes by, and what else wakes it in the AI's lorebook (JSON text).
  aliases     String?
  keywords    String?
  /// S4d: its lorebook activation (SillyTavern World Info's fields, JSON text).
  lore        String?
  /// Where it came from: homebrew, official or adapted, and its source.
  provenance  String   @default("homebrew")
  source      String?
  /// Its picture by https link (fandom, wikis…), shown before an uploaded one.
  pictureUrl  String?
  /// S4c: how the AI plays them (JSON text: personality, speech, first_message, examples); GM-facing.
  voice       String?
  locationId   String?
  gender       String?
  birthDate    DateTime?
  deathDate    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime
  updatedById  String?
  /// Soft delete: a tombstone a since-sync reads (rpg-ai A15); hidden from normal reads.
  deletedAt    DateTime?

  @@index([createdById])
  @@index([deletedAt])
  @@index([campaignId])
  @@index([settingId])
}

