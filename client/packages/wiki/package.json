{
  "name": "@zephyrex-rpg/wiki",
  "version": "0.0.1",
  "description": "Zephyrex RPG Wiki's pages, components and data hooks, for an app that composes the wiki (rpg-ai's Together mode).",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@prisma/client": "*",
    "@zephyrex/lite": "*",
    "lucide-react": "*",
    "next": "*",
    "react": "*",
    "swr": "*",
    "zephyrex": "*",
    "zod": "*"
  },
  "files": [
    "dist",
    "prisma",
    "scripts/prisma-fragment.mjs"
  ],
  "scripts": {
    "compile": "node scripts/compile.mjs",
    "verify:dist": "node scripts/verify-dist.mjs"
  },
  "peerDependenciesMeta": {
    "@prisma/client": {
      "optional": true
    },
    "@zephyrex/lite": {
      "optional": true
    }
  }
}
